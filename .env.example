# Copie para .env (na raiz do repositório) e preencha. NUNCA commite o .env.
# Gerar SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Origens do frontend (a lista é separada por vírgula, sem espaços)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:5173

DB_NAME=industrial_manager
DB_USER=postgres
DB_PASSWORD=troque-esta-senha
# Rodando o Django fora do Docker: localhost. Dentro do Docker o compose força "db".
DB_HOST=localhost
DB_PORT=5432
